{
  "name": "poe2-campaign-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "content:acquire": "node scripts/acquire-content.ts",
    "content:acquisition:check": "node scripts/acquire-content.ts --check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium-desktop --project=chromium-narrow --project=firefox-smoke --project=webkit-smoke",
    "test:visual": "playwright test tests/visual",
    "test:performance": "playwright test tests/performance --project=chromium-desktop",
    "build": "npm run content:acquisition:check && npm run typecheck && vite build"
  },
  "dependencies": {
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
